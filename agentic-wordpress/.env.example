# Copy this file to .env and fill in real values. .env is gitignored (see
# .gitignore) — never commit real secrets. In CI (see .github/workflows/),
# the same variable names are set as repository Secrets instead of a file —
# scripts/lib/ssh-target.sh and docker-compose.yml read both the same way.

# --- docker-compose (VPS or any non-wp-env hosting — see README.md's
# "Optional: docker-compose for VPS demo hosting") ---
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# --- Deploy / sync target (scripts/deploy.sh, scripts/sync-products.sh) ---
# SSH connection string for the VPS, e.g. deploy@store.example.com
VPS_HOST=deploy@vps.example.com
# Where this repo (docker-compose.yml included) is checked out on the VPS.
VPS_REMOTE_PATH=~/agentic-wordpress
# Path to the private key used to connect, e.g. ~/.ssh/agentic-wordpress-vps.
# Leave unset to use ssh's normal default identity/agent instead.
VPS_SSH_KEY=
