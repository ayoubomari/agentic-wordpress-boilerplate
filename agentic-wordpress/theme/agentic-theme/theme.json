{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1400px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "contrast", "color": "#1a1a1a", "name": "Contrast" },
        { "slug": "subtle", "color": "#f8f1ee", "name": "Subtle background" },
        { "slug": "muted", "color": "#6b6b6b", "name": "Muted text" },
        { "slug": "border", "color": "#ece0da", "name": "Border" },
        { "slug": "accent", "color": "#c96f52", "name": "Accent (terracotta)" },
        { "slug": "sale", "color": "#c23b3a", "name": "Sale" },
        { "slug": "blush", "color": "#f0d7d0", "name": "Blush" },
        { "slug": "sand", "color": "#ecd9c3", "name": "Sand" },
        { "slug": "new-badge", "color": "#3f7d4e", "name": "New badge" },
        { "slug": "selling-fast", "color": "#6d5bd0", "name": "Selling fast badge" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontWeight": "100 1000",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/DMSans-Variable.woff2"]
            },
            {
              "fontFamily": "DM Sans",
              "fontWeight": "100 1000",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/DMSans-Variable-Italic.woff2"]
            }
          ]
        },
        {
          "slug": "heading",
          "name": "Heading",
          "fontFamily": "'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" },
        {
          "slug": "x-large",
          "name": "Extra large",
          "size": "1.75rem",
          "fluid": { "min": "1.5rem", "max": "2.25rem" }
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "2.75rem",
          "fluid": { "min": "2rem", "max": "3.75rem" }
        }
      ]
    },
    "spacing": {
      "units": ["px", "%", "rem", "em", "vh", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "1 — Tight", "size": "0.5rem" },
        { "slug": "30", "name": "2 — Small", "size": "1rem" },
        { "slug": "40", "name": "3 — Base", "size": "1.5rem" },
        { "slug": "50", "name": "4 — Medium", "size": "2.5rem" },
        { "slug": "60", "name": "5 — Large", "size": "4rem" },
        { "slug": "70", "name": "6 — Section", "size": "5.5rem" },
        { "slug": "80", "name": "7 — Hero", "size": "7rem" }
      ]
    },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 1px 2px rgba(18,18,18,0.06)" },
        { "slug": "lifted", "name": "Lifted", "shadow": "0 6px 24px rgba(18,18,18,0.10)" }
      ]
    }
  },

  "styles": {
    "css": ":root{--agentic-radius-pill:999px;--agentic-radius-card:10px;--agentic-radius-panel:20px;}",
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": { "left": "1.5rem", "right": "1.5rem" },
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "800",
          "lineHeight": "1.15",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--contrast)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "typography": { "textDecoration": "none" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--contrast)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": { "radius": "999px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--contrast)" },
        "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "500",
          "textDecoration": "none",
          "letterSpacing": "0.02em"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "600",
          "letterSpacing": "-0.01em"
        },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/navigation": {
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" },
        "elements": { "link": { "typography": { "textDecoration": "none" } } }
      },
      "core/post-title": {
        "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--border)" }
      },
      "woocommerce/product-price": {
        "typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
      }
    }
  },

  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],

  "customTemplates": [
    {
      "name": "page-full-width",
      "title": "Page — full width",
      "postTypes": ["page"]
    }
  ]
}
