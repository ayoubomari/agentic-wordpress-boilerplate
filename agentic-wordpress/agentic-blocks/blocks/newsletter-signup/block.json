{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "agentic/newsletter-signup",
  "title": "Newsletter Signup",
  "category": "agentic",
  "icon": "email",
  "description": "Email capture block. Leave action empty to store signups in-house and email the admin; point it at your ESP to post there instead.",
  "attributes": {
    "heading": { "type": "string", "default": "Stay in the loop" },
    "description": { "type": "string", "default": "" },
    "buttonText": { "type": "string", "default": "Subscribe" },
    "action": { "type": "string", "default": "" },
    "placeholder": { "type": "string", "default": "your@email.com" }
  },
  "supports": { "align": ["wide", "full"], "spacing": { "margin": true, "padding": true } },
  "render": "file:./render.php",
  "style": "file:./style.css"
}
